{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicCharacterAndTemplateAssets",
      "Effect": "Allow",
      "Principal": {"AWS": ["*"]},
      "Action": ["s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::__BUCKET__/characters/*",
        "arn:aws:s3:::__BUCKET__/templates/*"
      ]
    }
  ]
}
